tellraw @a [{text:"========= ",color:yellow},{translate:"sw.gamestart.notice.title",color:red},{text:" =========",color:yellow}]
tellraw @a [{translate:"sw.gui.button.clock.game",color:green},{text:" : ",color:white},{score:{name:"gameTimeSeconds",objective:"gameSettings"},color:white},{text:"s",color:yellow}]
tellraw @a [{translate:"sw.gui.button.clock.ready",color:yellow},{text:" : ",color:white},{score:{name:"readyTimeSeconds",objective:"gameSettings"},color:white},{text:"s",color:yellow}]
tellraw @a [{translate:"sw.gui.button.clock.arena",color:red},{text:" : ",color:white},{score:{name:"arenaTimeSeconds",objective:"gameSettings"},color:white},{text:"s",color:yellow}]
tellraw @a [{text:""}]
execute if score nightVision gameSettings matches 1 run tellraw @a [{translate:"sw.gui.button.night_vision",color:green}]
execute if score nightVision gameSettings matches 0 run tellraw @a [{translate:"sw.gui.button.night_vision_off",color:red}]
execute if score keepInv gameSettings matches 1 run tellraw @a [{translate:"sw.gui.button.keepinv",color:green}]
execute if score keepInv gameSettings matches 0 run tellraw @a [{translate:"sw.gui.button.non_keepinv",color:red}]
execute if score friendFire gameSettings matches 1 run tellraw @a [{translate:"sw.gui.button.friendfire",color:green}]
execute if score friendFire gameSettings matches 0 run tellraw @a [{translate:"sw.gui.button.non_friendfire",color:red}]
tellraw @a [{text:"=================================",color:yellow}]